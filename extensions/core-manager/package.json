{
    "name": "core-manager",
    "displayName": "Content Manager",
    "description": "Adds a content manager page and functionality",
    "version": "1.0.0",
    "main": "./dist/extension.js",
    "contributes": {
        "moduleFederation": [
            {
                "scope": "core_manager",
                "path": "mf-manifest.json"
            }
        ],
        "themeFiles": [
            "core-manager.css"
        ]
    },
    "scripts": {
        "build": "gulp build --color",
        "watch": "gulp watch --color",
        "package": "gulp packageExt --color",
        "lint": "eslint src --ext ts"
    },
    "dependencies": {
        "@mdx-js/mdx": "3.1.0",
        "@mdx-js/react": "3.1.0",
        "@reduxjs/toolkit": "2.7.0",
        "mdast-util-mdx-jsx": "^3.2.0",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-error-boundary": "^6.0.0",
        "react-icons": "4.10.1",
        "react-markdown": "7.0.1",
        "react-window": "^2.2.3",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@module-federation/rsbuild-plugin": "^0.13.1",
        "@rsbuild/plugin-react": "1.3.0",
        "@rslib/core": "0.6.8",
        "@types/node": "18.x",
        "babel-plugin-react-compiler": "19.1.0-rc.1",
        "esbuild": "^0.25.12",
        "fast-xml-parser": "^5.3.3",
        "glob": "^11.0.2",
        "gulp": "5.0.1",
        "gulp-zip": "^5.0.2",
        "merge-stream": "^2.0.0",
        "react-router": "^7.9.5",
        "typescript": "^5.8.3"
    }
}
