{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (Web)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Frontend (Web)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/flashpoint/renderer",
      "webRoot": "${workspaceFolder}/src/renderer"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (Web)",
      "configurations": [
        "Debug Backend (Web)",
        "Debug Frontend (Web)"
      ]
    }
  ]
}
